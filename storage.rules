rules_version = '2';

// Report PDFs/DOCXs are written by the Admin SDK (functions/) and handed to
// the client only as time-limited signed URLs — the client never talks to
// this bucket directly, so there is nothing for a client-facing rule to
// grant. Locked shut, same reasoning as the (now-removed) Firestore rules
// this feature used to carry: defense-in-depth against a future accidental
// client SDK addition, not a functional requirement.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
