node_modules/
dist/
*.log

# The Hostinger upload package. Both are build output of
# tools/build-hostinger.js and are rebuilt in one command; committing a
# 2 MB zip per release would grow the repository for no one's benefit.
map-studio-*-hostinger.zip

# The accounts API's live configuration: the MySQL user and password for the
# deployment it belongs to. api/config.sample.php is the committed template;
# the filled-in copy belongs either here (ignored) or, better, one directory
# above public_html where no web server will serve it at all.
api/config.php
map-studio-config.php

# The Supabase export produced by tools/export-supabase.js. It contains every
# account's password hash and every map — it is a database backup, and it is
# not going in the repository.
map-studio-export.json

# Backend secrets — never commit a live Gemini or database credential.
# node_modules/ above already covers server/node_modules/.
# Both paths are kept: `functions/` was this directory's name before the
# backend moved off Firebase, and an ignore rule for a stale path costs
# nothing next to the cost of one un-ignored .env.
server/.env
server/.env.*
functions/.env
functions/.env.*
functions/.runtimeconfig.json

# Python bytecode cache (generated when .claude/skills/*/scripts/*.py run)
__pycache__/
*.pyc

# generated PPTX fixtures (reproducible via `npm run test:ppt` / demo.mjs)
test/ppt-export/fixtures/*.pptx
# unzip scratch dirs created while inspecting fixtures
test/ppt-export/fixtures/u_*/
test/ppt-export/fixtures/ud/

# browser-smoke unzip scratch
test/ppt-export/fixtures/bs/

# Screenshots the diagnostics harnesses write on each run. Evidence while you
# are looking at them, stale the moment the UI moves — regenerate by re-running
# the check rather than reading a committed copy of last month's layout.
diagnostics/*.png
diagnostics/**/*.png
